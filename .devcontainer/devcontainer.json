{
  "name": "GitLab — Iniciación",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8080, 5050],
  "portsAttributes": {
    "8080": { "label": "GitLab", "onAutoForward": "notify" },
    "5050": { "label": "Registro de imágenes", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["mhutchie.git-graph"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.repositoryScanMaxDepth": 4,
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
