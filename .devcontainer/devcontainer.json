{
  "name": "GitLab — Iniciación",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": false }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "GitLab", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": ["mhutchie.git-graph"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.repositoryScanMaxDepth": 4,
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
